# Sherlog Canvas Environment Configuration

# API Settings
SHERLOG_DEBUG=true
SHERLOG_API_HOST=0.0.0.0
SHERLOG_API_PORT=9091

SHERLOG_ENV=development

# Database Settings 
SHERLOG_DB_TYPE=sqlite  # Options: sqlite, postgresql
SHERLOG_DB_FILE=./data/sherlog.db
SHERLOG_DB_HOST=localhost
SHERLOG_DB_PORT=5432
SHERLOG_DB_NAME=sherlog
SHERLOG_DB_USER=sherlog
SHERLOG_DB_PASSWORD=sherlog

# Query execution settings
SHERLOG_DEFAULT_QUERY_TIMEOUT=30

SHERLOG_OPENROUTER_API_KEY=openrouter_api_key_here
SHERLOG_AI_MODEL=anthropic/claude-3.7-sonnet

# Redis Configuration
SHERLOG_REDIS_HOST=localhost
SHERLOG_REDIS_PORT=6379
SHERLOG_REDIS_DB=0
# SHERLOG_REDIS_PASSWORD=
SHERLOG_CHAT_SESSION_TTL=3600

SHERLOG_HOST_FS_ROOT=/Users/navneetkumar/Documents/sherlog-data

# LogAI MCP Server Configuration
SHERLOG_LOGAI_MCP_ENABLED=true
SHERLOG_LOGAI_MCP_COMMAND=docker
SHERLOG_LOGAI_MCP_IMAGE=ghcr.io/getsherlog/mcp-sherlog-log-analysis:latest
# SHERLOG_LOGAI_MCP_GITHUB_TOKEN=your_github_token_here  # Optional: for GitHub operations
SHERLOG_LOGAI_MCP_WORKING_DIR=/workspace
# SHERLOG_LOGAI_MCP_MOUNT_DIR=/path/to/host/directory  # Optional: host directory to mount
# SHERLOG_LOGAI_MCP_EXTRA_ARGS=["--network", "host"]  # Optional: extra docker arguments